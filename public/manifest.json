{
  "manifest_version": 3,
  "name": "KeyWest",
  "description": "Управление с клавиатуры и мыши и локальная проверка виртуального геймпада.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/keywest-16.png",
    "32": "icons/keywest-32.png",
    "48": "icons/keywest-48.png",
    "128": "icons/keywest-128.png"
  },
  "action": {
    "default_title": "Открыть стенд KeyWest",
    "default_icon": { "16": "icons/keywest-16.png", "32": "icons/keywest-32.png", "48": "icons/keywest-48.png" }
  },
  "background": { "service_worker": "open-tester.js" },
  "options_page": "index.html",
  "content_scripts": [{
    "matches": ["https://play.xbox.com/*"],
    "js": ["controller.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
